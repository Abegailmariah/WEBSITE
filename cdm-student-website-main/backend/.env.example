# CdM Student Portal — Backend Configuration
# Copy this file to .env in the backend/ directory and fill in the values.
# On your backend host (Render / Railway / Fly.io), set these as environment
# variables — do NOT commit the real .env. The frontend lives on Vercel, the
# backend lives here, so CORS + cookies must be set for cross-site.

# Port the API server listens on (default: 8000).
# Hosts like Render inject their own PORT — keep this as fallback only.
PORT=8000

# Admin PIN for the admin dashboard. REQUIRED — server exits(1) if missing.
# Must be LONG and random (>= 32 hex chars): it is the only credential in front
# of every student concern. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_PIN=change-me-in-production

# HMAC key used to sign CSRF tokens. Optional — falls back to ADMIN_PIN, which is
# why there is no mandatory new secret. Set it explicitly to be able to rotate
# CSRF tokens independently of the admin PIN.
# CSRF_SECRET=<another long random hex string>

# Session lifetime: sliding idle timeout, then an absolute hard cap that no
# session can outlive regardless of activity. (Default 2h idle / 12h absolute.)
SESSION_TTL_MS=7200000
# SESSION_ABSOLUTE_MAX_MS=43200000

# /admin/login brute-force lockout: N failed PIN attempts -> lock for M ms.
# ADMIN_MAX_FAILED=5
# ADMIN_LOCKOUT_MS=900000

# Comma-separated list of allowed frontend origins for CORS.
# Local dev: http://localhost:5173
# Prod: your Vercel URL(s), e.g. https://cdm-portal.vercel.app
# NEVER use "*" together with credentials: true.
CORS_ORIGINS=http://localhost:5173

# Set to "production" on the host to enable Secure cookies (HTTPS required).
# Required together with COOKIE_SAMESITE=none for cross-site (Vercel + Render).
NODE_ENV=development

# Cookie SameSite mode. Use "lax" for same-site/local dev, "none" for
# cross-site production (frontend on Vercel, API on another host).
# When "none", cookies require Secure (HTTPS) — set NODE_ENV=production.
COOKIE_SAMESITE=lax

# Where to store the SQLite file. Defaults to backend/cdm_portal.db.
# Set this when the data must live on a mounted volume, e.g. a Render
# persistent disk:  DB_PATH=/var/data/cdm_portal.db
# (See render.yaml — persistent disks require a paid instance type.)
# DB_PATH=/var/data/cdm_portal.db

# Student session tuning (optional overrides)
# STUDENT_SESSION_TTL_MS=43200000
# STUDENT_MAX_FAILED=5
# STUDENT_LOCKOUT_MS=900000


