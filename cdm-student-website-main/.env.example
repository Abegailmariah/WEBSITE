# CdM Student Portal — Environment Configuration
# Copy this file to .env and fill in the values.

# Backend endpoint for the Submit Concern form
# Default: http://localhost:8000/submit-concern
VITE_SUBMIT_CONCERN_ENDPOINT=http://localhost:8000/submit-concern

# Backend endpoint for fetching announcements
# Default: http://localhost:8000/announcements
VITE_ANNOUNCEMENTS_ENDPOINT=http://localhost:8000/announcements
