# Frontend Environment Configuration
# Area-Based Academic Information Dissemination System (BLE Beacon Technology)
#
# Copy this file to .env for local development.
#
# For Vercel: set these same keys in Project → Settings → Environment Variables
# (all environments), then REDEPLOY — Vite bakes import.meta.env into the
# bundle at build time, so an existing build keeps using the old values.

# ── Backend API endpoints ──────────────────────────────────────────
# Local dev: http://localhost:8000/...
# Production: your deployed backend, e.g. https://cdm-ble-api.onrender.com/...
# The API host must be listed in that backend's CORS_ORIGINS, and the backend
# must run with NODE_ENV=production + COOKIE_SAMESITE=none so cookies survive
# the cross-site request.
VITE_ANNOUNCEMENTS_ENDPOINT=http://localhost:8000/announcements
VITE_SUBMIT_CONCERN_ENDPOINT=http://localhost:8000/submit-concern
VITE_ADMIN_ENDPOINT=http://localhost:8000/admin


